{
  "root": true,
  "env": {
    "node": true,
    "browser": true,
    "es2021": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "warn",
    "no-empty": "warn",
    "no-constant-condition": "warn"
  },
  "ignorePatterns": [
    "node_modules/",
    "public/vendor/",
    "*.min.js"
  ]
}

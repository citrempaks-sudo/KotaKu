{
  "name": "ecohub-backend",
  "version": "1.0.0",
  "description": "Backend REST API untuk EcoHub (Solusi Smart City & Ekonomi Sirkular)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node create_database.js",
    "lint": "eslint .",
    "build:check": "node -e \"require('./server.js'); console.log('OK - server.js dimuat tanpa error');\"",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.4.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}